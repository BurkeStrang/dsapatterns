# C#-specific settings; general settings are inherited from the repo root.

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 80

# Style
csharp_style_namespace_declarations = file_scoped:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = false:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion

# Naming: PascalCase for types and methods, camelCase for locals and parameters
dotnet_naming_rule.methods_pascal.symbols = methods
dotnet_naming_rule.methods_pascal.style = pascal
dotnet_naming_rule.methods_pascal.severity = warning
dotnet_naming_symbols.methods.applicable_kinds = method, class, struct, interface, enum, property
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.locals_camel.symbols = locals
dotnet_naming_rule.locals_camel.style = camel
dotnet_naming_rule.locals_camel.severity = warning
dotnet_naming_symbols.locals.applicable_kinds = local, parameter
dotnet_naming_style.camel.capitalization = camel_case

# Practice code: don't require every internal class to be sealed
dotnet_diagnostic.CA1852.severity = none

# Practice code: no need to spell out a culture for parsing and formatting
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1309.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1311.severity = none
